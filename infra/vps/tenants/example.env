# Copy to <tenant>.env (e.g. turbenthal.env) — real tenant files are git-ignored.
TENANT_NAME=example
TENANT_HOST=example.rctrepairs.ch

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random        # openssl rand -hex 24
POSTGRES_DB=repair_platform

JWT_SECRET=change-me-long-random               # openssl rand -hex 48
# JWT_EXPIRES_IN=30d

# Images (defaults: GHCR latest). Pin IMAGE_TAG to a commit SHA for a controlled rollout.
# IMAGE_API=ghcr.io/paulshadwell/repair-platform/api
# IMAGE_WEB=ghcr.io/paulshadwell/repair-platform/web
# IMAGE_TAG=latest

# Password-reset e-mails (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@rctrepairs.ch
